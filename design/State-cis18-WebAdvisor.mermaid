classDiagram
    class ViewState {
        <<interface>>
        +enter(context ViewContext)
        +exit(context ViewContext)
        +render()
        +handleAction(action String, args String[])
        +getViewName() String
        +requiresAuthentication() boolean
    }

    class ViewContext {
        -currentState ViewState
        -history Deque~ViewState~
        -currentUser User
        +start()
        +navigateTo(state ViewState)
        +back()
        +logout()
        +handleAction(action String, args String[])
        +render()
    }

    class GuestViewState {
        <<singleton>>
        +INSTANCE GuestViewState$
        +enter(context ViewContext)
        +exit(context ViewContext)
        +render()
        +handleAction(action String, args String[])
        +getViewName() String
        +requiresAuthentication() boolean
    }

    class StudentDashboardViewState {
        <<singleton>>
        +INSTANCE StudentDashboardViewState$
        +enter(context ViewContext)
        +exit(context ViewContext)
        +render()
        +handleAction(action String, args String[])
        +getViewName() String
        +requiresAuthentication() boolean
    }

    class FacultyDashboardViewState {
        <<singleton>>
        +INSTANCE FacultyDashboardViewState$
