    class PermissionManagementViewState {
        <<singleton>>
        +INSTANCE PermissionManagementViewState$
        +enter(context ViewContext)
        +exit(context ViewContext)
        +render()
        +handleAction(action String, args String[])
        +getViewName() String
        +requiresAuthentication() boolean
    }

    class LoginViewState {
        <<singleton>>
        +INSTANCE LoginViewState$
        +getViewName() String
        +requiresAuthentication() boolean
    }

    ViewState <|.. GuestViewState
    ViewState <|.. StudentDashboardViewState
    ViewState <|.. FacultyDashboardViewState
    ViewState <|.. RegistrationViewState
    ViewState <|.. TranscriptViewState
    ViewState <|.. PermissionManagementViewState
    ViewState <|.. LoginViewState
    ViewContext --> ViewState
    GuestViewState ..> AuthenticationContext
    RegistrationViewState ..> RegistrationPeriodContext
    PermissionManagementViewState ..> FacultyPermissionContext